---
layout: layouts/home.njk
pagination:
    data: configuredLanguages
    size: 1
    alias: lang
permalink: "{{ lang.path }}/apps/"
pathSuffix: "/apps"
eleventyComputed:
  title: "Apps · {{ 'appTitle' | i18n(lang) }}"
description: "Download our apps for iOS and Android to write inventories on the go."
---
{#
  Native app landing page, one per language at /<lang>/apps/.

  TODO: the copy on this page is English-only for now. Move it to the Google Sheet ("App Text" tab)
  and switch to the i18n filter once it's translated.

  Badges are the official, localized App Store / Google Play badges, self-hosted in img/badges/
  (`npm run download-badges`). The Google PNGs are cropped to their visible edges at download time,
  so both badges can share one height here and line up exactly.
#}
<div class='bg-white dark:bg-slate-800 shadow-lg p-4 sm:p-8 rounded-lg m-3 sm:m-4 w-[calc(100%-1.5rem)] max-w-xl'>

  <div class='text-center'>
    <h2 class='text-2xl font-bold text-slate-900 dark:text-slate-100'>Apps</h2>
    <p class='mt-1 text-slate-500 dark:text-slate-400'>Download our apps for iOS and Android to write inventories on the go.</p>
  </div>

  {#
    Badges and bullets share one two-column grid (same 1rem column gap), so they meet on the same center line:
    the App Store badge and left-column bullets end at it, Google Play and right-column bullets start at it.
    On phones the badges stack (side by side they're wider than the card); the bullet columns stay.
  #}
  <div class='mt-6 grid grid-cols-2 gap-x-4'>
    <a href='{{ metadata.apps.ios.url }}' rel='noopener' class='col-span-2 sm:col-span-1 justify-self-center sm:justify-self-end hover:scale-105 transition-transform'>
      <img src='/img/badges/app-store-{{ lang.locale }}-black.svg' alt='Download on the App Store' class='h-[54px] w-auto dark:hidden'>
      <img src='/img/badges/app-store-{{ lang.locale }}-white.svg' alt='Download on the App Store' class='h-[54px] w-auto hidden dark:block'>
    </a>
    <a href='{{ metadata.apps.android.url }}' rel='noopener' class='col-span-2 sm:col-span-1 justify-self-center sm:justify-self-start mt-4 sm:mt-0 hover:scale-105 transition-transform'>
      <img src='/img/badges/google-play-{{ lang.locale }}.png' alt='Get it on Google Play' class='h-[54px] w-auto'>
    </a>

  {# Each column is its own list, so icons line up; the left list hugs the center line, so its longest item meets the App Store badge's edge #}
  <div class='col-span-2 mt-6 grid grid-cols-2 gap-x-4'>
    <ul class='justify-self-end space-y-2 text-sm font-medium text-slate-700 dark:text-slate-300'>
      <li class='flex items-center gap-2'>
        <svg xmlns="http://www.w3.org/2000/svg" class='icon-sm shrink-0 text-blue-500 dark:text-blue-400' fill="currentColor" viewBox="0 0 256 256" aria-hidden="true"><rect width="256" height="256" fill="none"></rect><circle cx="128" cy="128" r="96" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16"></circle><circle cx="128" cy="128" r="40" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16"></circle><line x1="128" y1="88" x2="215.3" y2="88" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16"></line><line x1="162.6" y1="148" x2="119" y2="223.6" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16"></line><line x1="93.4" y1="148" x2="49.7" y2="72.4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16"></line><line x1="32" y1="32" x2="224" y2="224" fill="none" class='stroke-white dark:stroke-slate-800' stroke-linecap="round" stroke-width="40"></line><line x1="32" y1="32" x2="224" y2="224" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="16"></line></svg>
        No browser needed
      </li>
      <li class='flex items-center gap-2'>
        <svg xmlns="http://www.w3.org/2000/svg" class='icon-sm shrink-0 text-blue-500 dark:text-blue-400' fill="currentColor" viewBox="0 0 256 256" aria-hidden="true"><rect width="256" height="256" fill="none"></rect><path d="M216,83.3V208a8,8,0,0,1-8,8H48a8,8,0,0,1-8-8V48a8,8,0,0,1,8-8H172.7a7.9,7.9,0,0,1,5.6,2.3l35.4,35.4A7.9,7.9,0,0,1,216,83.3Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16"></path><path d="M80,216V152a8,8,0,0,1,8-8h80a8,8,0,0,1,8,8v64" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16"></path><line x1="152" y1="72" x2="96" y2="72" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16"></line></svg>
        Saves your history
      </li>
    </ul>
    <ul class='justify-self-start space-y-2 text-sm font-medium text-slate-700 dark:text-slate-300'>
      <li class='flex items-center gap-2'>
        <svg xmlns="http://www.w3.org/2000/svg" class='icon-sm shrink-0 text-blue-500 dark:text-blue-400' fill="currentColor" viewBox="0 0 256 256" aria-hidden="true"><rect width="256" height="256" fill="none"></rect><path d="M128,216l-32,16V208l16-16V152L32,168V136l80-40V48a16,16,0,0,1,32,0V96l80,40v32l-80-16v40l16,16v24Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16"></path></svg>
        Works offline
      </li>
      <li class='flex items-center gap-2'>
        <svg xmlns="http://www.w3.org/2000/svg" class='icon-sm shrink-0 text-blue-500 dark:text-blue-400' fill="currentColor" viewBox="0 0 256 256" aria-hidden="true"><rect width="256" height="256" fill="none"></rect><path d="M48,168V128a80,80,0,0,1,160,0v16" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16"></path><path d="M80,200V128a48,48,0,0,1,96,0v40" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16"></path><path d="M112,224V128a16,16,0,0,1,32,0v56" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16"></path><path d="M176,200v24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16"></path><path d="M208,176v8" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16"></path></svg>
        Secure with biometrics
      </li>
    </ul>
  </div>
  </div>

</div>

<a href='{{ lang.path }}' class='button gap-1 px-4 mt-2 mb-10 whitespace-nowrap'>
